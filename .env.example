# ---------------------------------------------------------------------------
# My Energy — environment variables
# Copy to .env.local and fill in real values. Never commit .env.local.
# ---------------------------------------------------------------------------

# --- Database (Postgres / Supabase) ----------------------------------------
# Pooled connection used by the app at runtime (PgBouncer-compatible).
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
# Direct (non-pooled) connection used by the Prisma CLI (db push, studio, seed).
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# --- Auth (NextAuth / Auth.js) ---------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# The ONE email address granted the ADMIN role (exact match, case-insensitive).
# The matching account is created/kept as ADMIN; every other account is
# strictly USER, and /admin is unreachable for them. Set the real address in
# .env.local only — this file is committed.
ADMIN_EMAIL=""

# Public base URL, used to build absolute links in outgoing email (the
# back-in-stock notice links to the product page). Falls back to AUTH_URL and
# then http://localhost:3000, so set it in production or the links will be local.
NEXT_PUBLIC_SITE_URL=""

# --- Email (OTP codes + back-in-stock notices, via Gmail SMTP) -------------
# The Gmail address to send from:
SMTP_USER=""
# A Google APP PASSWORD (16 characters), NOT your Gmail account password.
# Requires 2-Step Verification — generate at:
# https://myaccount.google.com/apppasswords
SMTP_PASSWORD=""
# Optional overrides — default to Gmail (smtp.gmail.com:465, implicit TLS).
# Set these only when pointing at a different SMTP provider or a local
# test server; port 465 uses implicit TLS, other ports use STARTTLS.
SMTP_HOST=""
SMTP_PORT=""

# --- DHL shipment tracking -------------------------------------------------
# API key for the DHL "Shipment Tracking - Unified" API:
# https://developer.dhl.com/api-reference/shipment-tracking
DHL_API_KEY=""
# Optional override of the API host. Defaults to the production endpoint;
# set to "https://api-test.dhl.com" for a sandbox/developer key.
DHL_API_BASE=""

# --- AI (recommendations, market news, support chat, F-Gas verification) ---
# REQUIRED for /api/verify-fgas: the F-Gas certificate upload is audited by a
# vision model. Without this key the endpoint returns 500 AI_UNCONFIGURED and
# no certificate can be verified — it never falls back to accepting documents.
OPENAI_API_KEY=""
# Optional override for the certificate-auditing vision model (default gpt-4o).
# Must be a vision-capable model that supports structured outputs.
FGAS_VISION_MODEL=""

# --- Market Alerts news feeds ----------------------------------------------
# Optional. The dashboard widget pulls live HVAC/refrigeration industry news
# over RSS and caches it for an hour (lib/services/newsFetcher.ts). Leave
# empty to use the built-in default (Cooling Post).
# Format: comma-separated "URL|Display Name" pairs; the name is optional and
# falls back to the feed's hostname.
#   NEWS_FEED_URLS="https://www.coolingpost.com/feed/|Cooling Post,https://example.com/rss|Example"
NEWS_FEED_URLS=""

# --- Bank transfer (the only payment method) --------------------------------
# Where B2B buyers wire the money. Shown on the order confirmation and on the
# order page for as long as the transfer is outstanding, and printed on the
# invoice — none of this is secret.
#
# The live company and account details ship as the defaults in
# lib/bankTransfer.ts, so these are only needed to override them. Prefer
# setting them here if the account changes: a payment destination is worth
# being able to change, and review, without a code deploy.
BANK_BENEFICIARY=""
BANK_REGISTRATION_NUMBER=""
BANK_BENEFICIARY_ADDRESS=""
BANK_CONTACT_EMAIL=""
BANK_NAME=""
BANK_ADDRESS=""
BANK_IBAN=""
# Optional. Omitted from the UI entirely when empty — a made-up BIC is worse
# than none at all.
BANK_BIC=""

# --- F-Gas certificate storage --------------------------------------------
# Uploaded certificates are compliance documents (company name, certificate
# number, an individual's qualifications). They are NEVER written into
# public/ — see lib/fgasStorage.ts.
#
# With BLOB_READ_WRITE_TOKEN set, uploads go to Vercel Blob at an
# unguessable URL (which is also what lets Telegram fetch the file).
# Without it, they are written to FGAS_UPLOAD_DIR outside the web root and
# served only through /api/fgas/document, which checks that the caller owns
# the certificate or is an admin.
BLOB_READ_WRITE_TOKEN=""
# Local fallback directory. Default: .uploads/fgas (gitignored).
FGAS_UPLOAD_DIR=""

# --- Telegram admin notifications -------------------------------------------
# A message is sent to the admin chat the moment an order is placed, carrying
# the order number, customer, items, total and the delivery address.
#
# Optional: with either value missing the order is still created normally and
# a warning is logged — a notification channel must never be able to fail a
# paid-for order. Set both to actually receive them.
#
#   1. Create a bot with @BotFather, which gives you the token below.
#   2. Send your bot any message, then read the chat id from
#      https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ADMIN_CHAT_ID=""

# --- CRM inventory webhook --------------------------------------------------
# Shared secret the CRM sends as `Authorization: Bearer <secret>` when it
# POSTs stock levels to /api/webhooks/crm-inventory. The endpoint refuses
# every request (503) while this is empty. Generate with: openssl rand -hex 32
CRM_WEBHOOK_SECRET=""

# Bearer token Vercel Cron presents to /api/cron/*. Generate with
# `openssl rand -base64 32`. The endpoint fails CLOSED when this is unset —
# an open cron route could be used to mail every customer on demand.
CRON_SECRET=""
# Optional: override the model used to compose restock notes.
SMART_RESTOCK_MODEL=""
