// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client"
  output          = "../lib/generated/prisma"
  // Lets the datasource below declare the pgvector extension. Still a preview
  // feature in Prisma 7.9; the schema does not validate without it.
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  // Connection URLs live in prisma.config.ts (Prisma 7) and are passed
  // directly to the PrismaClient constructor via the pg adapter at runtime.
  //
  // Declaring the extension here tells Prisma the type exists so
  // Unsupported("vector(1536)") validates. It does NOT create the extension —
  // `CREATE EXTENSION` and the HNSW index are run by hand against Supabase
  // (see prisma/sql/2026-09-16_pgvector.sql).
  extensions = [vector]
}

// ---------------------------------------------------------------------------
// NextAuth (Auth.js) standard models, extended with Halocore account fields.
// Shape follows @auth/prisma-adapter's documented schema; Account/Session/
// VerificationToken are left at the standard adapter contract (no extra
// fields/timestamps) since the adapter reads/writes them directly.
// ---------------------------------------------------------------------------

/// Access roles (lib/rbac.ts holds the permission matrix).
///   SUPER_ADMIN  the owner — only the ADMIN_EMAIL account, enforced on every
///                request; never assignable, never demotable
///   ADMIN        operations: stock, orders, F-Gas review, support
///   ACCOUNTANT   read-only finance: turnover, revenue ledger, customers
///   USER         a buyer
enum Role {
  USER
  ADMIN
  ACCOUNTANT
  SUPER_ADMIN
}

/// Where a buyer's F-Gas certificate stands. Only VERIFIED (and not past its
/// expiry — see getEffectiveFgasStatus in lib/fgas.ts) unlocks F-Gas sales.
///
/// Decided by the 3-tier engine in app/api/verify-fgas (lib/fgasLifecycle):
///   VERIFIED        every regulatory criterion met, holder matches, no duplicate
///   PENDING_REVIEW  plausible certificate a person must confirm (holder name
///                   differs, no expiry printed, national-only citation, a
///                   number already active on another company's account…)
///   REJECTED        clearly not a valid certificate, with the failed checks
///   EXPIRED         was VERIFIED; its expiry date passed (daily cron, and
///                   treated as such at read time before the cron runs)
/// Admins override any of these (lib/fgasReview.ts). Every change is written
/// to FgasAuditLog.
enum FGasStatus {
  NONE
  PENDING_REVIEW
  VERIFIED
  REJECTED
  EXPIRED
}

/// Colour scheme. SYSTEM follows the device's prefers-color-scheme.
enum ThemePreference {
  LIGHT
  DARK
  SYSTEM
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  // RBAC: ADMIN is granted exclusively to the account whose email matches
  // the ADMIN_EMAIL environment variable — assigned at creation and
  // re-enforced on every sign-in (see lib/rbac.ts + auth.ts). Everyone
  // else is strictly USER.
  role Role @default(USER)

  // Password is optional: Google-only users never set one.
  password String?

  companyName       String?
  /// Buyer's VAT identification number, e.g. "NL863495921B01".
  ///
  /// Legally required on the invoice for EU cross-border B2B supplies: without
  /// it the reverse-charge mechanism cannot be applied and the sale has to be
  /// taxed domestically. Nullable because domestic consumers and pre-existing
  /// accounts have none — lib/pdf.ts omits the line when it is absent.
  vatNumber         String?
  // Editable job title shown on the dashboard identity card. Deliberately
  // separate from `role` (RBAC) — users may describe their job, never
  // grant themselves permissions.
  jobTitle          String?
  // Contact number for the account holder. Distinct from Address.phone,
  // which is the consignee a freight carrier calls about one delivery.
  phone             String?
  // Set whenever the password is changed through the verified flow.
  passwordChangedAt DateTime?

  // ── Two-factor authentication (TOTP / authenticator app) ──
  /// Base32 TOTP secret. Written when setup begins and only becomes
  /// effective once isTwoFactorEnabled flips, so a half-finished enrolment
  /// can never lock anyone out. Never leaves the server after setup.
  twoFactorSecret         String?
  isTwoFactorEnabled      Boolean   @default(false)
  /// TOTP time step of the last accepted code. RFC 6238 §5.2 requires a
  /// code to be accepted only once — otplib's `afterTimeStep` rejects
  /// anything at or below this, so an observed code cannot be replayed
  /// inside its 30-second window.
  twoFactorLastStep       Int?
  /// Consecutive wrong codes. Six digits is a million combinations; without
  /// a throttle an attacker holding the password can simply grind them.
  twoFactorFailedAttempts Int       @default(0)
  /// Set once the attempts ceiling is hit; verification refuses until it passes.
  twoFactorLockedUntil    DateTime?
  /// Consecutive wrong passwords (sign-in step 1 and the Credentials
  /// provider both count). The proxy's per-IP limiter is per-instance and
  /// spread across regions; this one is in the database and per account.
  loginFailedAttempts     Int       @default(0)
  /// Set when loginFailedAttempts reaches the ceiling (lib/loginThrottle).
  loginLockedUntil        DateTime?
  /// Recovery phrase (Settings → Security): a generated 12-word phrase or the
  /// buyer's own passphrase (≥ 12 characters), bcrypt-hashed after
  /// normalising case and spacing. Accepted wherever an authenticator code is
  /// — at sign-in and for step-up — so losing the phone is not losing the
  /// account. The hint is the buyer's own words, shown back in Settings.
  recoveryPhraseHash      String?
  recoveryPhraseHint      String?
  recoveryPhraseSetAt     DateTime?
  /// "SEED_12" (generated words, verified word-by-word) or "CUSTOM_PHRASE"
  /// (the buyer's passphrase, bcrypt in recoveryPhraseHash, with a hint).
  /// Null with a hash set = a phrase from before types existed: whole-phrase.
  recoveryPhraseType      String?
  /// SEED_12: per-user salt and 12 position-bound scrypt hashes, peppered
  /// with a server secret (lib/recoveryPhrase) — so a random subset of words
  /// can be challenged without the phrase ever being stored.
  recoveryPhraseSalt      String?
  recoveryWordHashes      Json?
  /// A generated phrase waiting for its 3-word backup confirmation; only
  /// hashes, never words. Promoted to the fields above when confirmed.
  recoveryPhrasePending   Json?
  /// Issue time of the last word challenge that was answered — any
  /// challenge issued at or before it is refused, so each is single-use.
  recoveryLastChallengeAt DateTime?
  /// bcrypt hashes of the single-use recovery codes, never the codes.
  /// Stored hashed because this array is the whole second factor for anyone
  /// who has lost their phone — a database leak of plaintext codes would be
  /// equivalent to leaking the TOTP secrets. Each entry is removed the
  /// moment it is spent.
  recoveryCodes           String[]
  // Legacy mirror of fGasStatus == VERIFIED. Kept in lockstep so any reader
  // not yet migrated still gates correctly; fGasStatus is the source of truth.
  epaVerified             Boolean   @default(false)

  // ── F-Gas compliance review ──
  // The certificate is read and judged by a vision model; an admin overrides.
  fGasStatus              FGasStatus         @default(NONE)
  /// Where the uploaded certificate is stored. Never public: local uploads
  /// are served through an authenticated route, and a blob URL is
  /// unguessable. See lib/fgasStorage.ts.
  fGasDocumentUrl         String?
  /// Reading from the vision model — what it says the document said. An
  /// admin compares it against the stored document rather than trusting it.
  fGasExtractedData       Json?
  fGasSubmittedAt         DateTime?
  fGasReviewedAt          DateTime?
  /// User id of the admin who approved or rejected it.
  fGasReviewedBy          String?
  fGasRejectionReason     String?
  /// Expiry of the certificate that makes this account VERIFIED (null for a
  /// certificate printed without one, accepted by an admin). Denormalised
  /// from the active Certificate so every gate can decide without a join.
  fGasExpiresAt           DateTime?
  /// A VERIFIED buyer's replacement certificate that is waiting for an admin
  /// (FgasAuditLog id). The current certificate stays active meanwhile.
  fGasPendingSubmissionId String?
  fgasAuditLog            FgasAuditLog[]
  fgasDocuments           FgasDocumentFile[]
  discountTier            String             @default("standard")
  rewardPoints            Int                @default(0)
  locale                  String             @default("en")
  /// Light / dark / follow the device. Mirrored into the session JWT so
  /// every device the user signs in on applies it (components/ThemeSync).
  themePreference         ThemePreference    @default(SYSTEM)

  /// Email preferences (Settings → Notifications). Defaults follow consent:
  /// back-in-stock is on because every one of those mails answers a
  /// product the user explicitly asked to watch; price drops and regulatory
  /// updates are opt-in, because unrequested marketing mail to EU business
  /// contacts needs prior consent under the ePrivacy rules.
  notifyBackInStock       Boolean   @default(true)
  notifyPriceDrops        Boolean   @default(false)
  notifyRegulatoryUpdates Boolean   @default(false)
  /// Predictive replenishment reminders (lib/smartRestock): "you usually
  /// reorder X about now". On by default — it's a service message about the
  /// customer's own buying pattern — with an opt-out in settings and a
  /// one-click unsubscribe in every reminder.
  notifyRestockReminders  Boolean   @default(true)
  /// How often restock reminders come: null = from the customer's own order
  /// cadence (lib/smartRestock, ≥ 2 purchases), or a fixed 14 / 30 / 60 days
  /// after their last purchase of a product (works from the first order).
  reorderReminderDays     Int?
  /// "Items left in your cart" reminder (lib/cartReminder). A service mail
  /// about the buyer's own unfinished order; one-click unsubscribe in each.
  notifyAbandonedCart     Boolean   @default(true)
  /// 30- and 7-day warnings before the F-Gas certificate lapses. The
  /// EXPIRED notice itself stays transactional and is not covered by this.
  notifyFgasExpiry        Boolean   @default(true)
  /// The fGasExpiresAt each warning was sent for. Comparing against the
  /// current expiry means a renewed certificate is warned about afresh, with
  /// no reset step, and an overlapping cron run cannot send one twice.
  fGasExpiryWarned30For   DateTime?
  fGasExpiryWarned7For    DateTime?
  /// "Sign out of all other devices": every session authenticated before
  /// this is refused (lib/sessionRevocation), like a password change.
  sessionsRevokedAt       DateTime?

  // For future CRM sync (e.g. HubSpot/Salesforce contact id).
  externalId String? @unique

  // Stripe Customer this buyer's checkouts run against, created lazily on
  // the first checkout (lib/stripe.ts). Required, not merely convenient,
  // for SEPA bank transfers: `customer_balance` credits the funds to a
  // customer, so the same id has to be reused or a transfer would land on
  // a customer nothing looks at.
  stripeCustomerId String? @unique

  accounts             Account[]
  sessions             Session[]
  addresses            Address[]
  orders               Order[]
  certificates         Certificate[]
  stockSubscriptions   StockSubscription[]
  cylinderTransactions CylinderTransaction[]
  restockAlerts        RestockAlert[]
  broadcastsSent       Broadcast[]           @relation("BroadcastAuthor")
  broadcastDeliveries  BroadcastRecipient[]
  quotes               Quote[]
  favorites            Favorite[]
  chatSessions         ChatSession[]
  savedCart            SavedCart?
  deviceSessions       UserSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  // Auth.js looks accounts up by user when linking or unlinking a provider.
  // Postgres does not index a foreign key for you, so this was a seq scan.
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Unused while the session strategy is JWT, but the adapter still queries
  // by user whenever a database session is read or revoked.
  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Email/password sign-in requires verifying the email via a 6-digit code
// before authorize() returns a user — see auth.ts's Credentials provider
// and lib/otp.ts.
model OtpCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  // Scopes what a code may be used for ("signin" | "password-change") —
  // a password-change code can never complete a sign-in and vice versa.
  purpose   String   @default("signin")
  /// Wrong guesses against this code; at the ceiling it is deleted (lib/otp).
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

// ---------------------------------------------------------------------------
// Halocore business models
// ---------------------------------------------------------------------------

enum OrderStatus {
  PENDING
  IN_TRANSIT
  DELIVERED
}

// Settlement state, tracked separately from fulfilment (OrderStatus).
// SEPA bank transfers settle days after checkout, so an order can sit at
// PENDING here long after the session was completed.
enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

/// Settlement state of an invoice document, separate from Order.paymentStatus:
/// an order can be PAID while its invoice is still being reissued, and a
/// CANCELLED invoice must not silently un-pay the order it belongs to.
enum InvoiceStatus {
  PENDING
  PAID
  CANCELLED
}

/// The billing document for one order.
///
/// Deliberately its own row rather than a field on Order: an invoice has its
/// own number series, its own issue and due dates, and its own lifecycle. The
/// PDF is regenerated from this row plus the order, so a stored file is a
/// cache, never the source of truth.
model Invoice {
  id String @id @default(cuid())

  /// Human-facing sequential reference, e.g. "INV-2026-0001". Unique so a
  /// number can never be issued twice, which is a legal requirement for
  /// billing documents in the EU.
  invoiceNumber String @unique

  /// One invoice per order, enforced at the database level.
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// Where a rendered copy lives, if one was stored (Blob/S3). Null means
  /// "render on demand" — the download route can always rebuild it.
  pdfUrl String?

  status   InvoiceStatus @default(PENDING)
  issuedAt DateTime      @default(now())
  /// Net terms. Null for immediately-settled card orders.
  dueDate  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The invoices list is read per user through the order; this supports
  /// "newest first" for the admin-wide view.
  @@index([status, issuedAt(sort: Desc)])
}

/// What a cylinder movement did to the customer's balance.
///
/// The first two move physical cylinders; the last two move money. They are
/// modelled as one ledger because a deposit is only ever charged or refunded
/// against a movement, and reconciling two separate tables would let the
/// count and the cash drift apart.
enum CylinderTransactionType {
  BORROWED
  RETURNED
  DEPOSIT_CHARGED
  DEPOSIT_REFUNDED
}

/// Append-only ledger of returnable-packaging movements.
///
/// Never updated or deleted: a correction is a new row in the opposite
/// direction, exactly as a financial ledger works. The customer's current
/// holding is therefore always derivable (sum of BORROWED minus sum of
/// RETURNED) and every change has an audit trail.
model CylinderTransaction {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The order that caused this movement. Optional: a return handed to a
  /// driver, or a manual correction by support, belongs to no order.
  /// SetNull rather than Cascade — deleting an order must not erase the fact
  /// that the customer still holds its cylinders.
  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  type CylinderTransactionType

  /// Always positive. Direction is carried by `type`, so a signed quantity
  /// would make "-5 RETURNED" expressible and ambiguous.
  quantity Int

  /// Free text for support: who collected them, which note number, why a
  /// correction was raised.
  notes String?

  createdAt DateTime @default(now())

  /// The ledger screen reads one user's rows newest-first, and the balance
  /// card sums them; both are served by this index.
  @@index([userId, createdAt(sort: Desc)])
  @@index([orderId])
}

/// Where a predicted restock stands.
///
/// PENDING is a prediction we have made but not yet acted on; NOTIFIED means
/// the customer has been emailed. The two are kept apart so a failed send
/// never leaves a row claiming the customer was contacted when they were not.
enum RestockAlertStatus {
  PENDING
  NOTIFIED
  CONVERTED
  DISMISSED
}

/// A predicted reorder, and the message sent about it.
///
/// This table exists as much to STOP us contacting people as to start: the
/// cron checks it before every send, so a customer whose cadence straddles
/// the seven-day window cannot be emailed about the same product week after
/// week. It is also the only place conversion can be measured — without a
/// row to mark CONVERTED there is no way to tell a working prediction from
/// a nuisance.
model RestockAlert {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Suggested reorder size, from the customer's own average order quantity.
  recommendedQty Int

  /// When we expect them to run out: last order + observed cadence.
  predictedDate DateTime

  status RestockAlertStatus @default(PENDING)

  /// The purchase cycle this alert is about: the customer's last order day
  /// (UTC) for this product when it was raised. Unique per (user, product),
  /// so a cycle can be reminded about at most once — a second cron run, a
  /// retried invocation or a dismissed alert can't produce another email.
  /// A new purchase starts a new cycle. Null on rows from before this column.
  cycleStart DateTime?

  /// The generated body. Null when a prediction was recorded but no message
  /// was produced — a row with NOTIFIED and no message would be a lie.
  aiMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId, cycleStart])
  /// The suppression lookup the cron runs before every send: "has this user
  /// been notified about this product recently?". Ordered so the newest row
  /// for a (user, product) pair is the first one read.
  @@index([userId, productId, createdAt(sort: Desc)])
  /// The dashboard widget reads a user's live alerts.
  @@index([userId, status])
}

/// One retrievable fact in the F-Gas knowledge base.
///
/// Chunks are written by scripts/seed-knowledge.ts and read only by the RAG
/// route's similarity search. Deliberately NOT related to Product: a chunk is
/// regulatory or engineering knowledge ("R-404A has a GWP of 3922"), which
/// stays true whether or not we happen to stock something. Product
/// suggestions are resolved separately, against the live catalogue.
/// Severity drives the InsightCard's treatment, so it is an enum rather than
/// a free string: a typo in "HIGH" would silently downgrade a warning.
enum InsightSeverity {
  HIGH
  MEDIUM
  LOW
}

/// Curated market intelligence, written in-house.
///
/// Distinct from the live industry feed in lib/services/newsFetcher.ts, which
/// pulls real RSS headlines from trade publications and is not stored here.
/// That feed is breadth — whatever the industry published today. This table is
/// judgement: an editor deciding that a quota date or a supply shock matters
/// enough to put in front of every buyer, with a severity attached.
///
/// The hub reads BOTH and merges them, so it is useful before a single row
/// exists here.
model MarketInsight {
  id      String @id @default(cuid())
  title   String
  content String

  severity InsightSeverity @default(MEDIUM)

  /// Free-form labels. Where a tag is a refrigerant designation ("R-404A")
  /// the personalised feed matches it against what the buyer actually
  /// purchases, so keep those in catalogue form — normalisation happens at
  /// read time, but an exact match costs nothing.
  tags String[]

  /// When it becomes relevant to readers, not when the row was written —
  /// an insight can be prepared ahead of a quota date.
  publishedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The hub asks for "latest, newest first" on every load.
  @@index([publishedAt(sort: Desc)])
  @@index([severity, publishedAt(sort: Desc)])
}

model KnowledgeChunk {
  id      String @id @default(cuid())
  content String

  /// 1536 dimensions = text-embedding-3-small.
  ///
  /// `Unsupported` means Prisma Client cannot read or write this column: it
  /// is invisible to findMany and cannot appear in a `select`. Every query
  /// that touches it goes through $queryRaw — that is a property of pgvector
  /// having no Prisma type, not a shortcut.
  ///
  /// Nullable so a chunk row can exist before its embedding is computed; the
  /// retrieval query filters those out.
  embedding Unsupported("vector(1536)")?

  /// Free-form provenance: source document, section, regulation reference.
  /// Returned with the chunk so an answer can cite where it came from.
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// NOTE: the vector index itself is NOT declared here. Prisma has no syntax
  /// for HNSW operator classes, so `db push` would silently leave the table
  /// without one and every search would fall back to a sequential scan.
  /// It is created by the raw SQL file instead.
  @@index([createdAt])
}

model Product {
  id         String  @id @default(cuid())
  externalId String? @unique
  name       String
  sku        String  @unique
  // Free-text pack label shown as the cart line's variant ("10 kg cylinder",
  // "Set"). The numbers that drive pricing live in the two fields below.
  weight     String
  gwpClass   String
  inStock    Boolean @default(true)

  // Gas is sold BY WEIGHT: the price of one full cylinder is
  // pricePerKg × weightKg (lib/pricing.ts), never a stored per-cylinder
  // figure. Equipment is priced per unit — weightKg 1, pricePerKg = the
  // unit price. Defaults exist only so `db push` can add the columns to a
  // populated table; prisma/sql/2026-09-08_price_per_kg.sql backfills them.
  pricePerKg Float @default(0)
  weightKg   Float @default(1)

  // Absolute on-hand count. Owned by the CRM (app/api/webhooks/crm-inventory
  // sets it outright on every push) and mirrored into inStock/stock by
  // lib/inventory.ts; placeOrder() also decrements it so the shop can't
  // oversell between two CRM pushes.
  stockQuantity Int @default(0)

  // Mandatory refundable deposit charged per cylinder on top of the gas
  // price — deliberately NOT folded into `price` (see lib/cart.ts). 0 for
  // equipment that isn't a returnable cylinder.
  cylinderDeposit Decimal @default(15.00) @db.Decimal(10, 2)

  // Product-list facets (My Energy Products design): batch purity %, GWP
  // figure, stock level ("in" | "low" | "order" | "out"), and catalog
  // category ("cylinders" | "blends" | "equipment" | "recovery").
  purity   Decimal? @db.Decimal(5, 2)
  gwp      Int?
  stock    String   @default("in")
  category String   @default("cylinders")

  /// What the gas ships in: "Cylinder", "Drum", "Isotank"… Shown in the size
  /// label ("800 kg drum") and the PDP size selector.
  containerType String  @default("Cylinder")
  /// Groups the sizes of one product: every row with the same key is a size
  /// of the same thing (R-134a in a 10 kg cylinder, an 800 kg drum…). Each
  /// size stays its own row — own SKU, price, stock, deposit, CRM id, order
  /// lines — this only says which rows belong together. Null falls back to
  /// the refrigerant mark, the grouping used before this column existed;
  /// set it to separate e.g. virgin from reclaimed R-404A.
  familyKey     String?

  /// Set when an admin deletes a size that has order or quote history: the
  /// row must survive for those records (OrderItem/QuoteItem point at it),
  /// but it leaves the storefront, checkout and quoting — every catalog
  /// read filters on `archivedAt: null` (LISTED in lib/productFamily). A
  /// size with no history is deleted outright instead.
  archivedAt DateTime?

  orderItems         OrderItem[]
  stockSubscriptions StockSubscription[]
  restockAlerts      RestockAlert[]
  quoteItems         QuoteItem[]
  favorites          Favorite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Out-of-stock rows sort to the bottom of every listing (lib/data.ts).
  @@index([inStock, createdAt])
  @@index([familyKey])
  @@index([archivedAt])
}

// Back-in-stock waitlist. A buyer (signed in or guest) leaves an address
// against an out-of-stock product; the CRM webhook mails everyone here the
// moment that product's quantity goes from 0 to any positive number, then
// marks them notified so a later restock never mails them twice.
model StockSubscription {
  id        String  @id @default(cuid())
  productId String
  /**
   * Contact address, always stored lower-cased. The identity for this waitlist.
   */
  email     String
  /**
   * Set when the subscriber was signed in; null for guests.
   */
  userId    String?
  /**
   * The locale the subscriber was browsing in when they joined, so the
   * back-in-stock mail links them to the page in their own language rather
   * than always /en. Re-subscribing refreshes it. Validated against
   * routing.locales before it is stored — it ends up inside a URL in an
   * email, so an unchecked value would be a link-injection vector.
   */
  locale    String  @default("en")

  /**
   * Flipped once the back-in-stock mail is away, so restocks don't spam.
   */
  notified   Boolean   @default(false)
  notifiedAt DateTime?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Deleting an account keeps the waitlist entry: the email still wants the mail.
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One row per address per product — re-subscribing re-arms the existing row.
  @@unique([productId, email])
  // The webhook's hot path: everyone still waiting on one product.
  @@index([productId, notified])
  // "My waitlist" reads a buyer's own subscriptions.
  @@index([userId])
}

model Address {
  id            String  @id @default(cuid())
  userId        String
  title         String
  recipientName String
  // Composed display string ("street, postal city, country") — kept as the
  // single source consumed by checkout/mobile; regenerated whenever the
  // structured fields below are saved. Legacy rows may have only this.
  fullAddress   String
  isDefault     Boolean @default(false)

  // Structured fields backing the dashboard address manager.
  street     String?
  city       String?
  postalCode String?
  country    String?
  // Delivery contact number. ADR freight carriers require a reachable
  // number for the consignee, so checkout asks for it — nullable only
  // because rows created before in-checkout address entry have none.
  phone      String?
  kind       String  @default("SHIPPING") // "SHIPPING" | "BILLING"

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // getUserAddresses filters by user and orders default-first.
  @@index([userId, isDefault])
}

model Order {
  id                String      @id @default(cuid())
  externalId        String?     @unique
  orderNumber       String      @unique
  userId            String
  status            OrderStatus @default(PENDING)
  totalAmount       Decimal     @db.Decimal(10, 2)
  estimatedDelivery DateTime

  // ── F-Gas compliance snapshot ──
  // The certificate that authorised this sale, frozen when the order was
  // placed. Null on orders with no F-Gas line (tools, hydrocarbons) and on
  // orders placed before this existed. Never updated afterwards.
  authorizingCertificateId        String?
  authorizingCertificateNumber    String?
  authorizingCertificateExpiresAt DateTime?

  // Stripe Checkout Session that owns this order. Unique so the webhook can
  // look the order up by session id and so a replayed event can never create
  // or settle a second order.
  stripeSessionId String?       @unique
  // How the buyer chose to pay ("card" | "sepa"), for support and reporting.
  paymentMethod   String?
  paymentStatus   PaymentStatus @default(PENDING)
  paidAt          DateTime?
  // Carrier tracking id (DHL). Set once the shipment is handed to the
  // carrier; orders without one show a status-derived timeline instead.
  trackingNumber  String?

  // Shipping address chosen at checkout. Nullable: pre-checkout seed orders
  // have none, and deleting an address must not delete its order history.
  addressId String?
  address   Address? @relation(fields: [addressId], references: [id], onDelete: SetNull)

  // Frozen copy of that address as it read at checkout, one line per field.
  //
  // The relation above is the customer's *current* address book entry: they
  // can edit it, or delete it (onDelete: SetNull) and orphan the order. Where
  // the cylinders were actually sent must not change retroactively, so the
  // delivery address is snapshotted here at order time. It is also what the
  // admin notification quotes.
  shippingAddress String?

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  quote Quote?
  items OrderItem[]

  // One invoice per order. Optional because an order exists the moment
  // checkout succeeds, and the invoice is written immediately after — a
  // failure in between must leave a payable order, not lose it.
  invoice              Invoice?
  // Cylinder movements this order caused (the BORROWED rows at checkout, and
  // any RETURNED rows raised against it later).
  cylinderTransactions CylinderTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The hottest read in the app: getUserOrders and the recommendation history
  // both select a user's orders newest-first, and the home page runs them on
  // every signed-in request. Sorted descending so the index satisfies the
  // ORDER BY as well as the filter, with no sort step.
  @@index([userId, createdAt(sort: Desc)])
  // getProfileDashboardData counts a user's PENDING/IN_TRANSIT orders.
  @@index([userId, status])
  @@index([addressId])
}

model OrderItem {
  id                   String  @id @default(cuid())
  orderId              String
  productId            String
  quantity             Int
  // Gas price of ONE cylinder at purchase time (pricePerKgAtPurchase ×
  // weightKgAtPurchase, rounded to cents). Kept as the line's unit price so
  // order history totals never drift when the catalog is repriced.
  priceAtPurchase      Decimal @db.Decimal(10, 2)
  // The per-kg rate and net weight behind priceAtPurchase, so the
  // confirmation can show "€25.00 / kg × 10 kg". 0 / 1 on lines placed
  // before weight-based pricing (the UI hides the breakdown then).
  pricePerKgAtPurchase Float   @default(0)
  weightKgAtPurchase   Float   @default(1)
  // Per-cylinder deposit on this line (Product.cylinderDeposit at purchase
  // time), so the confirmation can show it as its own row.
  depositAtPurchase    Decimal @default(0) @db.Decimal(10, 2)

  // ── Carbon footprint snapshot (F-Gas compliance reporting) ──
  //
  // GWP of the gas as the catalogue carried it when the order was placed.
  // Snapshotted for the same reason as the price fields above: published GWP
  // values are revised (R-1234yf was 4 under AR4 and is under 1 in newer
  // assessments), and a report re-run next year must reproduce the figure
  // that was reported, not today's. Null for equipment, which has no GWP —
  // and on rows placed before this column existed.
  gwpAtPurchase Int?
  // This line's footprint in KILOGRAMS of CO2-equivalent:
  //     weightKgAtPurchase × quantity × gwpAtPurchase
  // Stored so an audit document prints the number that was recorded rather
  // than one recomputed by whatever the code does later. It is deliberately
  // derivable from the three columns above, so an auditor can verify it
  // rather than having to trust it — lib/compliance.ts recomputes it from
  // those inputs for exactly that reason. Kilograms, not tonnes: tonnes are
  // a display unit (divide by 1000) and rounding to them here would lose
  // precision on small lines.
  co2eKg        Float @default(0)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Prisma resolves a nested `items` include as `where: { orderId: { in: [...] } }`.
  // Without this it is a sequential scan of every line item ever sold.
  @@index([orderId])
  @@index([productId])
}

/// An accepted F-Gas certificate. One per acceptance; the buyer's current one
/// has isActive = true (at most one per user), earlier ones stay as history.
model Certificate {
  id       String   @id @default(cuid())
  userId   String
  certType String
  /// Legacy name for certificateNumber; both are written.
  certId   String
  /// When WE accepted it. (The document's own issue date is documentIssuedAt.)
  issuedAt DateTime

  certificateNumber String?
  /// certificateNumber upper-cased with every non-alphanumeric removed: what
  /// the duplicate check compares across accounts.
  numberKey         String?
  companyName       String?
  holderName        String?
  /// ISO 3166-1 alpha-2 of the issuing EU member state, when legible.
  countryCode       String?
  issuingBody       String?
  category          String?
  regulationCited   String?
  documentIssuedAt  DateTime?
  /// Null when the certificate prints no expiry (accepted by an admin only).
  expiresAt         DateTime?
  documentUrl       String?
  isActive          Boolean   @default(false)
  /// Who accepted it: an admin's user id, or "ai-vision".
  approvedBy        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // getUserProfile takes the newest certificate for a user.
  @@index([userId, issuedAt(sort: Desc)])
  @@index([numberKey, isActive])
}

/// Every F-Gas event, append-only: submissions, AI verdicts, admin
/// approvals / rejections / revocations, expiries. Nothing here is updated
/// or deleted by the application.
model FgasAuditLog {
  id             String      @id @default(cuid())
  userId         String
  /// SUBMITTED_VERIFIED | SUBMITTED_PENDING | SUBMITTED_REJECTED |
  /// REPLACEMENT_REJECTED | ADMIN_APPROVED | ADMIN_REJECTED | ADMIN_REVOKED |
  /// AUTO_EXPIRED | LEGACY_MIGRATED
  action         String
  /// Admin user id, "ai-vision" or "system".
  actorId        String
  previousStatus FGasStatus?
  newStatus      FGasStatus?
  /// Certificate number as read (not a foreign key: a rejected document has none).
  certificateId  String?
  extractedData  Json?
  /// The itemised checks behind an automatic verdict (lib/fgas FgasCheck[]).
  checks         Json?
  reason         String?
  documentUrl    String?
  createdAt      DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
}

/// Certificate documents stored in PostgreSQL when Vercel Blob is not
/// configured (or fails). AES-256-GCM encrypted at the application layer;
/// served only by /api/fgas/document/<key> to the owner or an admin.
model FgasDocumentFile {
  /// The public key in the URL: "db-<uuid>".
  id        String   @id
  userId    String
  mimeType  String
  size      Int
  sha256    String
  /// Which key encrypted it (lib/fgasStorage KEY_REFS).
  keyRef    String
  iv        Bytes
  authTag   Bytes
  data      Bytes
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// One admin-composed email to everyone opted in to a topic (today:
/// regulatory updates). The recipient rows are the work queue: the audience
/// is snapshotted at send time, and lib/broadcast.ts drains it in
/// time-boxed batches so no single serverless invocation runs long.
model Broadcast {
  id      String          @id @default(cuid())
  /// Which preference gates it — matches lib/notifications NotificationTopic.
  topic   String          @default("regulatory")
  subject String
  content String          @db.Text
  status  BroadcastStatus @default(SENDING)

  authorId String
  author   User   @relation("BroadcastAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  /// Denormalised progress for the admin list; recomputed from the
  /// recipient rows after every batch, which stay the source of truth.
  total   Int @default(0)
  sent    Int @default(0)
  skipped Int @default(0)
  failed  Int @default(0)

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  recipients BroadcastRecipient[]

  @@index([status, createdAt])
}

enum BroadcastStatus {
  SENDING
  COMPLETED
  CANCELLED
}

model BroadcastRecipient {
  id          String          @id @default(cuid())
  broadcastId String
  broadcast   Broadcast       @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      RecipientStatus @default(PENDING)
  /// Send attempts so far; a row is retried until MAX_ATTEMPTS, then FAILED.
  attempts    Int             @default(0)
  lastError   String?
  /// When a worker took it. A SENDING row older than the lease is presumed
  /// abandoned (the invocation died) and is reclaimed.
  claimedAt   DateTime?
  sentAt      DateTime?

  /// One email per person per broadcast, enforced by the database.
  @@unique([broadcastId, userId])
  @@index([broadcastId, status])
  @@index([userId])
}

enum RecipientStatus {
  PENDING
  SENDING
  SENT
  /// Opted out (or lost their address) between the snapshot and the send.
  SKIPPED
  FAILED
}

/// A quote's stored lifecycle. EXPIRED is also derived on read — a PENDING
/// quote past validUntil is expired whether or not a write has caught up
/// (lib/quotes.ts effectiveQuoteStatus), so the 48-hour promise never
/// depends on a cron.
enum QuoteStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

/// A formal price offer: the cart priced from the database at one moment
/// and frozen for 48 hours, so a buyer can take a PDF to their management.
/// Every figure is a snapshot — later price, weight or deposit changes to
/// the products never alter an issued quote. Stock is not reserved.
model Quote {
  id          String      @id @default(cuid())
  /// QUO-<year>-<4 chars>, printed on the document.
  quoteNumber String      @unique
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      QuoteStatus @default(PENDING)
  validUntil  DateTime

  /// The buyer block as it read when the quote was issued.
  buyerName   String?
  buyerEmail  String?
  companyName String?
  vatNumber   String?

  /// Same breakdown checkout charges (lib/cart calculateCartTotals).
  subtotal       Decimal @db.Decimal(12, 2)
  depositTotal   Decimal @db.Decimal(12, 2)
  shippingAmount Decimal @db.Decimal(12, 2)
  vatAmount      Decimal @db.Decimal(12, 2)
  totalAmount    Decimal @db.Decimal(12, 2)

  items QuoteItem[]

  /// The order placed from this quote at the quoted prices; set in the same
  /// transaction that moves the quote to ACCEPTED, so one quote buys once.
  orderId String? @unique
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
}

model QuoteItem {
  id        String  @id @default(cuid())
  quoteId   String
  quote     Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  /// Restrict: a product with quotes against it is archived, not deleted.
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  sku        String
  name       String
  /// Pack label, e.g. "80 kg drum".
  variant    String
  quantity   Int
  pricePerKg Float
  weightKg   Float
  /// One container's gas price: pricePerKg × weightKg, rounded to cents.
  unitPrice  Decimal @db.Decimal(12, 2)
  /// Refundable per-container deposit, outside the VAT base.
  deposit    Decimal @db.Decimal(10, 2)
  /// unitPrice × quantity — gas only, deposit excluded.
  lineTotal  Decimal @db.Decimal(12, 2)

  @@index([quoteId])
  @@index([productId])
}

/// A product size a buyer saved to their Favorites. Each size is its own
/// Product row, so a favourite is one specific container (the 10 kg R-32
/// cylinder, not "R-32").
///
/// The price-drop email (lib/priceDrop.ts) goes to favourites whose owner
/// opted in to price-drop alerts (User.notifyPriceDrops). lastAlertPrice /
/// lastAlertAt remember what we last told this buyer about this product, so
/// a price nudged down three times in an afternoon is one email, not three.
model Favorite {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// The container price (EUR, gas only) in the last price-drop email.
  lastAlertPrice Decimal?  @db.Decimal(12, 2)
  lastAlertAt    DateTime?

  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([productId])
}

/// Where a support conversation stands. The AI answers only while
/// AI_ACTIVE; once ESCALATED_TO_HUMAN it stays silent and the team replies
/// from /admin/support. RESOLVED closes it — the visitor's next message
/// starts a fresh session.
enum ChatSessionStatus {
  AI_ACTIVE
  ESCALATED_TO_HUMAN
  RESOLVED
}

enum ChatRole {
  user
  assistant
  human_agent
}

/// One support conversation from the storefront chat widget. Guests have no
/// userId; their browser is tied to the session by a signed httpOnly cookie
/// (lib/chatSession.ts), never by an id in a URL.
model ChatSession {
  id     String            @id @default(cuid())
  userId String?
  /// Cascade: deleting an account erases its conversations (they hold the
  /// buyer's own words), not just the link to them.
  user   User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  status ChatSessionStatus @default(AI_ACTIVE)

  /// Why it was handed to a person — the model's reason, or "requested by
  /// the visitor" when they pressed the button.
  escalationReason String?
  escalatedAt      DateTime?
  resolvedAt       DateTime?
  /// Page the conversation started on, for context in the admin view.
  startedOn        String?

  messages ChatMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, updatedAt])
  /// The retention purge filters on updatedAt alone (lib/chatRetention).
  @@index([updatedAt])
  @@index([userId])
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      ChatRole
  content   String      @db.Text
  /// Structured parts that aren't text: the product ids a catalog search
  /// showed, the escalation marker — so a reloaded transcript (and the admin
  /// view) shows what the visitor actually saw.
  data      Json?
  createdAt DateTime    @default(now())

  @@index([sessionId, createdAt])
}

/// Server copy of a signed-in buyer's basket, kept only so an abandoned cart
/// can be reminded about (lib/cartReminder). The browser cart stays the
/// source of truth for the UI; this holds SKUs and quantities, never prices
/// — the reminder reads today's price and stock from Product at send time.
/// The row is deleted when the basket is emptied or an order is placed.
model SavedCart {
  userId           String    @id
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// [{ sku, qty }] — validated against the catalogue on write.
  items            Json
  itemCount        Int
  /// When the CONTENTS last changed. A sync that sends the same basket again
  /// does not move it, so re-opening a tab can't postpone or re-arm a reminder.
  contentUpdatedAt DateTime
  reminderSentAt   DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([contentUpdatedAt])
}

/// One signed-in device. Sessions are stateless JWTs; each token carries a
/// `sid` (sessionTokenId) and auth.ts refuses a token whose row is revoked.
/// Rows are never deleted on sign-out-everywhere — revokedAt is the record —
/// and a row is created on first sight of a token that predates this table.
model UserSession {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionTokenId String    @unique
  /// "Chrome · macOS" — parsed from the User-Agent (lib/deviceSessions).
  deviceName     String
  browser        String?
  os             String?
  /// desktop | mobile | tablet
  deviceType     String?
  ipAddress      String?
  city           String?
  country        String?
  createdAt      DateTime  @default(now())
  lastActiveAt   DateTime  @default(now())
  revokedAt      DateTime?

  @@index([userId, revokedAt])
}
